@{
    ViewData["Title"] = "لاگین/رجیستر";
    ViewBag.Page = "خانه";
    Layout = null;
}
<link rel="stylesheet" href="~/css/bookstore.css" />
<style>
    .auth-page{
        direction:rtl;
    }
</style>
<!-- ================= AUTH ================= -->
<main class="auth-page">
    <section class="auth-container" aria-label="ورود و ثبت‌نام">
        <div class="auth-visual">
            <div class="auth-visual-content">
                <span class="auth-badge">Navak Book Shop</span>
                <h1>به دنیای آرام کتاب‌ها خوش آمدید</h1>
                <p>
                    وارد حساب کاربری خود شوید یا در نَواک ثبت‌نام کنید تا سفارش‌ها،
                    کتاب‌های موردعلاقه و پیشنهادهای ویژه همیشه در دسترس باشند.
                </p>

                <div class="auth-benefits">
                    <div>
                        <i class="fa-solid fa-truck-fast"></i>
                        <span>پیگیری سفارش‌ها</span>
                    </div>
                    <div>
                        <i class="fa-regular fa-heart"></i>
                        <span>ذخیره علاقه‌مندی‌ها</span>
                    </div>
                    <div>
                        <i class="fa-solid fa-gift"></i>
                        <span>دریافت پیشنهادهای ویژه</span>
                    </div>
                </div>
            </div>

            <div class="auth-book auth-book-one">
                <span>Novel</span>
                <h3>فصل تازه</h3>
            </div>
            <div class="auth-book auth-book-two">
                <span>Navak</span>
                <h3>کتاب محبوب</h3>
            </div>
        </div>

        <div class="auth-card">
            <div class="auth-tabs">
                <button class="auth-tab active" type="button" data-auth-tab="login">ورود</button>
                <button class="auth-tab" type="button" data-auth-tab="register">ثبت‌نام</button>
            </div>

            <form class="auth-form active" id="loginForm">
                <div class="auth-title">
                    <h2>ورود به حساب</h2>
                    <p>خوش برگشتی! لطفاً اطلاعات حساب خود را وارد کن.</p>
                </div>

                <div class="form-group">
                    <label for="loginEmail">ایمیل</label>
                    <div class="input-box">
                        <i class="fa-regular fa-envelope"></i>
                        <input type="email" id="loginEmail" placeholder="example@email.com" required />
                    </div>
                </div>

                <div class="form-group">
                    <label for="loginPassword">رمز عبور</label>
                    <div class="input-box">
                        <i class="fa-solid fa-lock"></i>
                        <input type="password" id="loginPassword" placeholder="رمز عبور خود را وارد کنید" required />
                        <button class="toggle-password" type="button" aria-label="نمایش رمز عبور">
                            <i class="fa-regular fa-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="form-options">
                    <label class="remember-me">
                        <input type="checkbox" />
                        <span>مرا به خاطر بسپار</span>
                    </label>
                    <a href="#">فراموشی رمز عبور؟</a>
                </div>

                <button class="auth-submit" type="submit">
                    ورود به نَواک
                    <i class="fa-solid fa-arrow-left"></i>
                </button>

                <div class="auth-divider"><span>یا ورود با</span></div>

                <div class="social-login">
                    <button type="button">
                        <i class="fa-brands fa-google"></i>
                        گوگل
                    </button>
                    <button type="button">
                        <i class="fa-brands fa-telegram"></i>
                        تلگرام
                    </button>
                </div>
            </form>

            <form class="auth-form" id="registerForm">
                <div class="auth-title">
                    <h2>ساخت حساب کاربری</h2>
                    <p>برای خرید راحت‌تر و ذخیره کتاب‌های محبوبت ثبت‌نام کن.</p>
                </div>

                <div class="form-group">
                    <label for="registerName">نام و نام خانوادگی</label>
                    <div class="input-box">
                        <i class="fa-regular fa-user"></i>
                        <input type="text" id="registerName" placeholder="نام کامل شما" required />
                    </div>
                </div>

                <div class="form-group">
                    <label for="registerEmail">ایمیل</label>
                    <div class="input-box">
                        <i class="fa-regular fa-envelope"></i>
                        <input type="email" id="registerEmail" placeholder="example@email.com" required />
                    </div>
                </div>

                <div class="form-group">
                    <label for="registerPassword">رمز عبور</label>
                    <div class="input-box">
                        <i class="fa-solid fa-lock"></i>
                        <input type="password" id="registerPassword" placeholder="حداقل ۸ کاراکتر" required />
                        <button class="toggle-password" type="button" aria-label="نمایش رمز عبور">
                            <i class="fa-regular fa-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="form-group">
                    <label for="confirmPassword">تکرار رمز عبور</label>
                    <div class="input-box">
                        <i class="fa-solid fa-shield-halved"></i>
                        <input type="password" id="confirmPassword" placeholder="رمز عبور را دوباره وارد کنید" required />
                        <button class="toggle-password" type="button" aria-label="نمایش رمز عبور">
                            <i class="fa-regular fa-eye"></i>
                        </button>
                    </div>
                </div>

                <label class="terms-check">
                    <input type="checkbox" required />
                    <span>قوانین و مقررات نَواک را می‌پذیرم.</span>
                </label>

                <button class="auth-submit" type="submit">
                    ثبت‌نام در نَواک
                    <i class="fa-solid fa-arrow-left"></i>
                </button>
            </form>
        </div>
    </section>
</main>
<script src="~/js/bookstore.js"></script>