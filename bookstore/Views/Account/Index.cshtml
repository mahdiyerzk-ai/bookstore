@* @model Login *@
@{
    ViewData["Title"] = "لاگین/رجیستر";
    ViewBag.Page = "خانه";
    Layout = null;
}
<link rel="stylesheet" href="~/css/bookstore.css" />
<style>
    .auth-page{
        direction:rtl;
    }
</style>
<!-- ================= AUTH ================= -->
<main class="auth-page">
    <section class="auth-container" aria-label="ورود و ثبت‌نام">
        <div class="auth-visual">
            <div class="auth-visual-content">
                <span class="auth-badge">Navak Book Shop</span>
                <h1>به دنیای آرام کتاب‌ها خوش آمدید</h1>
                <p>
                    وارد حساب کاربری خود شوید یا در نَواک ثبت‌نام کنید تا سفارش‌ها،
                    کتاب‌های موردعلاقه و پیشنهادهای ویژه همیشه در دسترس باشند.
                </p>

                <div class="auth-benefits">
                    <div>
                        <i class="fa-solid fa-truck-fast"></i>
                        <span>پیگیری سفارش‌ها</span>
                    </div>
                    <div>
                        <i class="fa-regular fa-heart"></i>
                        <span>ذخیره علاقه‌مندی‌ها</span>
                    </div>
                    <div>
                        <i class="fa-solid fa-gift"></i>
                        <span>دریافت پیشنهادهای ویژه</span>
                    </div>
                </div>
            </div>

            <div class="auth-book auth-book-one">
                <span>Novel</span>
                <h3>فصل تازه</h3>
            </div>
            <div class="auth-book auth-book-two">
                <span>Navak</span>
                <h3>کتاب محبوب</h3>
            </div>
        </div>

        <div class="auth-card">
            <div class="auth-tabs">
                <button class="auth-tab active" type="button" data-auth-tab="login">ورود</button>
                <button class="auth-tab" type="button" data-auth-tab="register">ثبت‌نام</button>
            </div>
            
            <partial name="_Login" />
            
            <partial name="_Register" />
        
        </div>
    </section>
</main>
<script src="~/js/bookstore.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.js"></script>