<main class="contact-page">

    <section class="contact-hero">
        <span>تماس با نَواک</span>
        <h1>ما اینجاییم تا کمکت کنیم</h1>
        <p>
            برای سوال درباره سفارش، پیشنهاد کتاب، همکاری یا پشتیبانی می‌تونی از فرم زیر با ما در ارتباط باشی.
        </p>
    </section>

    <section class="contact-layout">

        <div class="contact-info">

            <article class="contact-info-card">
                <i class="fa-solid fa-phone"></i>
                <div>
                    <h3>شماره تماس</h3>
                    <p>021-12345678</p>
                </div>
            </article>

            <article class="contact-info-card">
                <i class="fa-solid fa-envelope"></i>
                <div>
                    <h3>ایمیل</h3>
                    <p>info@navakbook.com</p>
                </div>
            </article>

            <article class="contact-info-card">
                <i class="fa-solid fa-location-dot"></i>
                <div>
                    <h3>آدرس</h3>
                    <p>تهران، خیابان نمونه، فروشگاه نَواک</p>
                </div>
            </article>

            <article class="contact-info-card">
                <i class="fa-solid fa-clock"></i>
                <div>
                    <h3>ساعت پاسخگویی</h3>
                    <p>شنبه تا پنجشنبه، ۹ تا ۱۸</p>
                </div>
            </article>

            <div class="contact-social-box">
                <h3>ما را دنبال کن</h3>

                <div class="contact-social">
                    <a href="#"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#"><i class="fa-brands fa-telegram"></i></a>
                    <a href="#"><i class="fa-brands fa-twitter"></i></a>
                    <a href="#"><i class="fa-brands fa-youtube"></i></a>
                </div>
            </div>

        </div>

        <section class="contact-form-box">
            <span>ارسال پیام</span>
            <h2>پیامت را برای ما بنویس</h2>

            <form class="contact-form" id="contactForm">
                <div class="form-row">
                    <div class="form-group">
                        <label for="name">نام و نام خانوادگی</label>
                        <input type="text" id="name" placeholder="مثلاً مهسا اقبالی" required />
                    </div>

                    <div class="form-group">
                        <label for="phone">شماره تماس</label>
                        <input type="tel" id="phone" placeholder="مثلاً 09123456789" />
                    </div>
                </div>

                <div class="form-group">
                    <label for="email">ایمیل</label>
                    <input type="email" id="email" placeholder="example@email.com" required />
                </div>

                <div class="form-group">
                    <label for="subject">موضوع پیام</label>
                    <input type="text" id="subject" placeholder="موضوع پیام خود را بنویسید" required />
                </div>

                <div class="form-group">
                    <label for="message">متن پیام</label>
                    <textarea id="message" rows="6" placeholder="پیام خود را اینجا بنویسید..." required></textarea>
                </div>

                <button type="submit" class="contact-submit-btn">
                    ارسال پیام
                    <i class="fa-solid fa-paper-plane"></i>
                </button>

                <p class="contact-form-message" id="contactFormMessage"></p>
            </form>
        </section>

    </section>

    <section class="contact-map-box">
        <div class="contact-map-placeholder">
            <i class="fa-solid fa-map-location-dot"></i>
            <h3>موقعیت فروشگاه نَواک</h3>
            <p>
                در نسخه واقعی سایت می‌تونی این قسمت را با نقشه گوگل یا لوکیشن فروشگاه جایگزین کنی.
            </p>
        </div>
    </section>

</main>