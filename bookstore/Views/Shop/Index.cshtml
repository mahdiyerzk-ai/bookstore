@model bookstore.Models.ViewModels.ShopIndexViewModel
@using bookstore.Models.ViewModels
@{
    ViewData["Title"] = "فروشگاه";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Shop.css" asp-append-version="true" />
}

<main class="shop-page">

    <section class="shop-hero">
        <span>فروشگاه نَواک</span>
        <h1>کتاب مورد علاقه‌ات را پیدا کن</h1>
        <p>
            مجموعه‌ای از کتاب‌های منتخب، پرفروش و تازه‌رسیده برای یک تجربه خرید ساده و آرام.
        </p>
    </section>

    <section class="shop-layout">

        <!-- Sidebar -->
        <aside class="shop-sidebar">

            <div class="shop-filter-box">
                <h3>دسته‌بندی‌ها</h3>

                <div class="shop-filter-list">
                    <button class="shop-filter-btn active" type="button" data-filter="all">
                        همه کتاب‌ها
                    </button>

                    @foreach (var category in Model.Categories)
                    {
                        <button class="shop-filter-btn" type="button" data-filter="@category.Id">
                            @category.Name
                        </button>
                    }
                </div>
            </div>

            <div class="shop-filter-box">
                <h3>پیشنهاد نَواک</h3>
                <p class="shop-sidebar-text">
                    برای شروع، کتاب‌های پرفروش و منتخب نَواک بهترین انتخاب هستند.
                </p>

                <a href="#shopProducts" class="shop-sidebar-link">
                    مشاهده کتاب‌ها
                    <i class="fa-solid fa-arrow-left"></i>
                </a>
            </div>

        </aside>

        <!-- Content -->
        <section class="shop-content-area">

            <div class="shop-toolbar">
                <div class="shop-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" id="shopSearch" placeholder="جستجو بر اساس نام کتاب یا نویسنده..." />
                </div>

                <select id="shopSort">
                    <option value="default">مرتب‌سازی پیش‌فرض</option>
                    <option value="low-high">ارزان‌ترین</option>
                    <option value="high-low">گران‌ترین</option>
                    <option value="newest">جدیدترین</option>
                </select>
            </div>

            <div class="shop-result-info">
                <p>
                    نمایش
                    <strong id="shopResultCount">@Model.Products.Count.ToPersianDigits()</strong>
                    کتاب
                </p>
            </div>

            <div class="shop-products-grid" id="shopProducts">

                @foreach (var product in Model.Products)
                {
                    <article class="shop-product-card product-mini-card@(product.InStock ? "" : " is-soldout")"
                             data-book-id="@product.Id"
                             data-category="@product.CategoryId"
                             data-price="@((long)product.Price)"
                             data-date="@product.Id.ToString("D10")">

                        <button class="favorite-btn" type="button" aria-label="افزودن به علاقه‌مندی‌ها">
                            <i class="fa-regular fa-heart"></i>
                        </button>

                        <a asp-action="Details" asp-route-id="@product.Id" class="shop-product-img">
                            @if (!product.InStock)
                            {
                                <span class="shop-sale-badge shop-soldout-badge">ناموجود</span>
                            }
                            <img src="@product.CoverUrl" alt="جلد کتاب @product.Name" loading="lazy" />
                        </a>

                        <div class="book-card-content shop-product-info">
                            <span class="shop-product-category">@product.CategoryName</span>
                            <h3 title="@product.Name">
                                <a asp-action="Details" asp-route-id="@product.Id" class="shop-title-link">@product.Name</a>
                            </h3>
                            <p>@(string.IsNullOrWhiteSpace(product.Author) ? "نویسنده نامشخص" : product.Author)</p>

                            <div class="book-meta shop-product-meta">
                                <span>@product.CategoryName</span>
                                @if (!string.IsNullOrWhiteSpace(product.ISBN))
                                {
                                    <span>شابک: @product.ISBN.ToPersianDigits()</span>
                                }
                            </div>

                            @if (product.LowStock)
                            {
                                <div class="shop-stock-note">تنها @product.StockQuantity.ToPersianDigits() عدد در انبار</div>
                            }

                            <div class="book-price shop-product-price">
                                <strong>@product.Price.ToTomanText()</strong>
                                <span>تومان</span>
                            </div>

                            @if (product.InStock)
                            {
                                <a href="#" class="shop-add-btn">
                                    <i class="fa-solid fa-bag-shopping"></i>
                                    افزودن به سبد
                                </a>
                            }
                            else
                            {
                                <button type="button" class="shop-soldout-btn" disabled>
                                    ناموجود
                                </button>
                            }
                        </div>
                    </article>
                }

            </div>

            <div class="shop-empty @(Model.Products.Count == 0 ? "show" : "")" id="shopEmpty">
                <i class="fa-regular fa-face-sad-tear"></i>
                <h3>کتابی پیدا نشد</h3>
                <p>@(Model.Products.Count == 0 ? "هنوز کتابی در فروشگاه ثبت نشده است." : "عبارت جستجو یا فیلتر را تغییر بده.")</p>
            </div>

        </section>

    </section>

</main>

@section Scripts {
    <script src="~/js/Shop.js" asp-append-version="true"></script>
}
