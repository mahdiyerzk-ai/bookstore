@using bookstore.Models.ViewModels
@model LoginViewModel

<form class="auth-form active" id="loginForm"
      method="post" asp-controller="Account" asp-action="Login">
    @if (ViewBag.Message != null)
    {
        <p class="text-danger">@ViewBag.Message</p>
    }
      <div class="auth-title">
        <h2>ورود به حساب</h2>
        <p>خوش برگشتی! لطفاً اطلاعات حساب خود را وارد کن.</p>
    </div>

    <div class="form-group">
        <label for="loginEmail" asp-for="Email"></label>
        <div class="input-box">
            <i class="fa-regular fa-envelope"></i>
            <input type="email"  id="loginEmail" asp-for="Email" placeholder="example@email.com" />
            <span class="text-danger" asp-validation-for="Email"></span>
        </div>
    </div>

    <div class="form-group">
        <label for="loginPassword" asp-for="Password"></label>
        <div class="input-box">
            <i class="fa-solid fa-lock"></i>
            <input type="password" id="loginPassword" asp-for="Password" placeholder="رمز عبور خود را وارد کنید" required />
            <button class="toggle-password" type="button" aria-label="نمایش رمز عبور">
                <i class="fa-regular fa-eye"></i>
            </button>
        </div>
    </div>

    <div class="form-options">
        <label class="remember-me">
            <input type="checkbox" />
            <span>مرا به خاطر بسپار</span>
        </label>
        <a href="#">فراموشی رمز عبور؟</a>
    </div>

    <button class="auth-submit" type="submit">
        ورود به نَواک
        <i class="fa-solid fa-arrow-left"></i>
    </button>

    <div class="auth-divider"><span>یا ورود با</span></div>

    <div class="social-login">
        <button type="button">
            <i class="fa-brands fa-google"></i>
            گوگل
        </button>
        <button type="button">
            <i class="fa-brands fa-telegram"></i>
            تلگرام
        </button>
    </div>
</form>
