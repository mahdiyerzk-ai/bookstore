@model bookstore.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<style>
    .delete-product-page {
        max-width: 850px;
        margin: 0 auto;
        padding: 32px;
        animation: pageFadeIn .55s ease both;
    }

    /* =========================
           Header
        ========================= */

    .delete-product-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }

    .delete-product-heading {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .delete-title-icon {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        background: rgba(217, 45, 32, .09);
        color: #d92d20;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .delete-title-icon svg {
            width: 25px;
            height: 25px;
        }

    .delete-product-heading h1 {
        margin: 0;
        color: #073b3a;
        font-size: 28px;
        font-weight: 800;
        letter-spacing: -.4px;
    }

    .delete-product-heading p {
        margin: 5px 0 0;
        color: #7b8b8a;
        font-size: 14px;
    }

    .back-products-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 17px;
        border: 1px solid #e2e9e8;
        border-radius: 12px;
        background: #fff;
        color: #526563;
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
        transition: all .25s ease;
    }

        .back-products-btn svg {
            width: 17px;
            height: 17px;
        }

        .back-products-btn:hover {
            color: #0f9d8a;
            border-color: rgba(15, 157, 138, .35);
            background: rgba(15, 157, 138, .04);
            transform: translateY(-2px);
        }

    /* =========================
           Main Card
        ========================= */

    .delete-product-card {
        background: #fff;
        border: 1px solid #e8eeee;
        border-radius: 22px;
        box-shadow: 0 12px 35px rgba(7, 59, 58, .06);
        overflow: hidden;
        animation: cardSlideUp .65s ease both;
    }

    .delete-card-header {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 22px 26px;
        border-bottom: 1px solid #edf1f1;
        background: linear-gradient( 180deg, #ffffff 0%, #fffafa 100% );
    }

    .delete-header-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: rgba(217, 45, 32, .09);
        color: #d92d20;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .delete-header-icon svg {
            width: 21px;
            height: 21px;
        }

    .delete-card-header h2 {
        margin: 0;
        color: #073b3a;
        font-size: 17px;
        font-weight: 800;
    }

    .delete-card-header p {
        margin: 3px 0 0;
        color: #8a9998;
        font-size: 12px;
    }

    .delete-product-content {
        padding: 28px;
    }

    /* =========================
           Warning
        ========================= */

    .delete-warning {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 17px 18px;
        margin-bottom: 22px;
        border: 1px solid #f5d6a4;
        border-radius: 14px;
        background: #fffbf3;
        color: #8a5700;
    }

    .delete-warning-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: rgba(247, 144, 9, .12);
        color: #d97706;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .delete-warning-icon svg {
            width: 20px;
            height: 20px;
        }

    .delete-warning h3 {
        margin: 0 0 4px;
        color: #7a4b00;
        font-size: 14px;
        font-weight: 800;
    }

    .delete-warning p {
        margin: 0;
        color: #926d32;
        font-size: 12px;
        line-height: 1.8;
    }

    /* =========================
           Product Preview
        ========================= */

    .delete-product-preview {
        display: flex;
        align-items: center;
        gap: 17px;
        padding: 18px;
        margin-bottom: 25px;
        border: 1px solid #e8eeee;
        border-radius: 15px;
        background: #fbfcfc;
    }

    .delete-product-image {
        width: 72px;
        height: 92px;
        border-radius: 10px;
        object-fit: cover;
        background: #f1f5f4;
        border: 1px solid #e2e9e8;
        flex-shrink: 0;
    }

    .delete-product-placeholder {
        width: 72px;
        height: 92px;
        border-radius: 10px;
        background: #f1f5f4;
        border: 1px solid #e2e9e8;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #a0afad;
        flex-shrink: 0;
    }

        .delete-product-placeholder svg {
            width: 29px;
            height: 29px;
        }

    .delete-product-info {
        min-width: 0;
    }

        .delete-product-info h3 {
            margin: 0 0 6px;
            color: #073b3a;
            font-size: 17px;
            font-weight: 800;
            word-break: break-word;
        }

    .delete-product-author {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #7b8b8a;
        font-size: 12px;
    }

        .delete-product-author svg {
            width: 14px;
            height: 14px;
            color: #0f9d8a;
        }

    /* =========================
           Product Meta
        ========================= */

    .delete-product-meta {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 25px;
    }

    .delete-meta-item {
        padding: 13px 14px;
        border: 1px solid #e8eeee;
        border-radius: 11px;
        background: #fff;
    }

    .delete-meta-label {
        margin-bottom: 5px;
        color: #91a09f;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .3px;
    }

    .delete-meta-value {
        color: #314a48;
        font-size: 13px;
        font-weight: 750;
    }

    /* =========================
           Actions
        ========================= */

    .delete-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        padding-top: 22px;
        border-top: 1px solid #edf1f1;
    }

    .delete-confirm-btn,
    .delete-cancel-btn {
        min-height: 45px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 11px;
        font-size: 13px;
        font-weight: 750;
        text-decoration: none;
        cursor: pointer;
        transition: all .25s ease;
    }

    .delete-confirm-btn {
        border: 1px solid #d92d20;
        background: #d92d20;
        color: #fff;
        box-shadow: 0 7px 18px rgba(217, 45, 32, .15);
    }

        .delete-confirm-btn:hover {
            background: #b42318;
            border-color: #b42318;
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 10px 22px rgba(217, 45, 32, .22);
        }

    .delete-cancel-btn {
        border: 1px solid #e0e7e6;
        background: #fff;
        color: #60716f;
    }

        .delete-cancel-btn:hover {
            color: #334846;
            background: #f7f9f9;
            border-color: #cfd9d8;
            transform: translateY(-2px);
        }

        .delete-confirm-btn svg,
        .delete-cancel-btn svg {
            width: 17px;
            height: 17px;
        }

    /* =========================
           Animations
        ========================= */

    @@keyframes pageFadeIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes cardSlideUp {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* =========================
           Responsive
        ========================= */

    @@media (max-width: 768px) {

        .delete-product-page {
            padding: 22px 16px;
        }

        .delete-product-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .back-products-btn {
            width: 100%;
            justify-content: center;
        }

        .delete-product-heading h1 {
            font-size: 24px;
        }

        .delete-product-card {
            border-radius: 18px;
        }

        .delete-card-header {
            padding: 19px;
        }

        .delete-product-content {
            padding: 20px;
        }

        .delete-product-meta {
            grid-template-columns: 1fr;
        }

        .delete-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .delete-confirm-btn,
        .delete-cancel-btn {
            width: 100%;
        }
    }

    @@media (max-width: 500px) {

        .delete-product-page {
            padding: 18px 12px;
        }

        .delete-product-heading {
            gap: 11px;
        }

        .delete-title-icon {
            width: 46px;
            height: 46px;
            border-radius: 13px;
        }

        .delete-product-heading h1 {
            font-size: 21px;
        }

        .delete-product-heading p {
            font-size: 12px;
        }

        .delete-product-content {
            padding: 16px;
        }

        .delete-product-preview {
            align-items: flex-start;
        }

        .delete-warning {
            padding: 14px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {

        .delete-product-page,
        .delete-product-card {
            animation: none;
        }

        .back-products-btn,
        .delete-confirm-btn,
        .delete-cancel-btn {
            transition: none;
        }
    }
</style>


<div class="delete-product-page">

    <!-- Header -->
    <div class="delete-product-header">

        <div class="delete-product-heading">

            <div class="delete-title-icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <path d="M3 6h18"></path>
                    <path d="M8 6V4h8v2"></path>
                    <path d="M19 6l-1 14H6L5 6"></path>
                    <path d="M10 11v5"></path>
                    <path d="M14 11v5"></path>

                </svg>

            </div>

            <div>

                <h1>Delete Product</h1>

                <p>
                    Permanently remove this product from your bookstore.
                </p>

            </div>

        </div>


        <a asp-action="Index"
           class="back-products-btn">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <path d="M19 12H5"></path>
                <path d="M12 19l-7-7 7-7"></path>

            </svg>

            Back to Products

        </a>

    </div>


    <!-- Main Card -->
    <div class="delete-product-card">

        <div class="delete-card-header">

            <div class="delete-header-icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <path d="M10.3 3.2h3.4l1 2H20v2H4v-2h5.3l1-2Z"></path>
                    <path d="M6 7.2l1 13h10l1-13"></path>
                    <path d="M10 11v5"></path>
                    <path d="M14 11v5"></path>

                </svg>

            </div>

            <div>

                <h2>Confirm Product Deletion</h2>

                <p>
                    Please review the product before confirming.
                </p>

            </div>

        </div>


        <div class="delete-product-content">

            <!-- Warning -->
            <div class="delete-warning">

                <div class="delete-warning-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M10.3 3.2 2.6 17a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 3.2a2 2 0 0 0-3.4 0Z"></path>
                        <path d="M12 9v4"></path>
                        <path d="M12 16h.01"></path>

                    </svg>

                </div>

                <div>

                    <h3>Are you sure you want to delete this product?</h3>

                    <p>
                        This action will permanently remove
                        <strong>@Model.Name</strong>
                        from the bookstore.
                        This action cannot be undone.
                    </p>

                </div>

            </div>


            <!-- Product Preview -->
            <div class="delete-product-preview">

                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl"
                         alt="@Model.Name"
                         class="delete-product-image" />
                }
                else
                {
                    <div class="delete-product-placeholder">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.6"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <rect x="3"
                                  y="3"
                                  width="18"
                                  height="18"
                                  rx="2">
                            </rect>

                            <circle cx="8.5"
                                    cy="8.5"
                                    r="1.5">
                            </circle>

                            <path d="M21 15l-5-5L5 21"></path>

                        </svg>

                    </div>
                }

                <div class="delete-product-info">

                    <h3>
                        @Model.Name
                    </h3>

                    @if (!string.IsNullOrWhiteSpace(Model.Author))
                    {
                        <div class="delete-product-author">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <path d="M20 21a8 8 0 0 0-16 0"></path>

                                <circle cx="12"
                                        cy="7"
                                        r="4">
                                </circle>

                            </svg>

                            <span>
                                @Model.Author
                            </span>

                        </div>
                    }

                </div>

            </div>


            <!-- Product Meta -->
            <div class="delete-product-meta">

                <div class="delete-meta-item">

                    <div class="delete-meta-label">
                        Category
                    </div>

                    <div class="delete-meta-value">
                        @(Model.Category?.Name ?? "No category")
                    </div>

                </div>


                <div class="delete-meta-item">

                    <div class="delete-meta-label">
                        Price
                    </div>

                    <div class="delete-meta-value">
                        @Model.Price.ToString("N2")
                    </div>

                </div>


                <div class="delete-meta-item">

                    <div class="delete-meta-label">
                        Stock
                    </div>

                    <div class="delete-meta-value">
                        @Model.StockQuantity
                    </div>

                </div>

            </div>


            <!-- Actions -->
            <form asp-action="Delete"
                  method="post">

                <input type="hidden"
                       asp-for="Id" />

                <div class="delete-actions">

                    <a asp-action="Index"
                       class="delete-cancel-btn">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M18 6L6 18"></path>
                            <path d="M6 6l12 12"></path>

                        </svg>

                        Cancel

                    </a>


                    <button type="submit"
                            class="delete-confirm-btn">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M3 6h18"></path>
                            <path d="M8 6V4h8v2"></path>
                            <path d="M19 6l-1 14H6L5 6"></path>
                            <path d="M10 11v5"></path>
                            <path d="M14 11v5"></path>

                        </svg>

                        Delete Product

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>