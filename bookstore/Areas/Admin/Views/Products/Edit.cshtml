@model bookstore.Models.Product

@{
    ViewData["Title"] = "Update Product";
}

<style>
    .edit-product-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 32px;
        animation: pageFadeIn .55s ease both;
    }

    /* =========================
           Header
        ========================= */

    .edit-product-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }

    .edit-product-heading {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .edit-product-title-icon {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        background: rgba(15, 157, 138, .10);
        color: #0f9d8a;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .edit-product-title-icon svg {
            width: 25px;
            height: 25px;
        }

    .edit-product-heading h1 {
        margin: 0;
        color: #073b3a;
        font-size: 28px;
        font-weight: 800;
        letter-spacing: -.4px;
    }

    .edit-product-heading p {
        margin: 5px 0 0;
        color: #7b8b8a;
        font-size: 14px;
    }

    .back-products-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 17px;
        border: 1px solid #e2e9e8;
        border-radius: 12px;
        background: #fff;
        color: #526563;
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
        transition: all .25s ease;
    }

        .back-products-btn svg {
            width: 17px;
            height: 17px;
        }

        .back-products-btn:hover {
            color: #0f9d8a;
            border-color: rgba(15, 157, 138, .35);
            background: rgba(15, 157, 138, .04);
            transform: translateY(-2px);
        }

    /* =========================
           Main Card
        ========================= */

    .edit-product-card {
        background: #fff;
        border: 1px solid #e9eeee;
        border-radius: 22px;
        box-shadow: 0 12px 35px rgba(7, 59, 58, .06);
        overflow: hidden;
        animation: cardSlideUp .65s ease both;
    }

    .edit-product-card-header {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 22px 26px;
        border-bottom: 1px solid #edf1f1;
        background: linear-gradient( 180deg, #ffffff 0%, #fbfdfd 100% );
    }

    .form-header-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: rgba(15, 157, 138, .09);
        color: #0f9d8a;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .form-header-icon svg {
            width: 21px;
            height: 21px;
        }

    .edit-product-card-header h2 {
        margin: 0;
        font-size: 17px;
        font-weight: 800;
        color: #073b3a;
    }

    .edit-product-card-header p {
        margin: 3px 0 0;
        color: #8a9998;
        font-size: 12px;
    }

    .edit-product-form {
        padding: 28px;
    }

    /* =========================
           Validation
        ========================= */

    .validation-summary {
        border: 1px solid #f1c8c8;
        background: #fff6f6;
        color: #b42318;
        border-radius: 12px;
        padding: 13px 16px;
        margin-bottom: 25px;
        font-size: 13px;
        animation: shakeIn .4s ease both;
    }

        .validation-summary:empty {
            display: none;
        }

    .field-validation-error {
        display: block;
        margin-top: 7px;
        font-size: 12px;
        color: #d92d20;
    }

    /* =========================
           Form Fields
        ========================= */

    .product-form-field {
        margin-bottom: 22px;
        animation: fieldFadeIn .5s ease both;
    }

        .product-form-field:nth-child(1) {
            animation-delay: .05s;
        }

        .product-form-field:nth-child(2) {
            animation-delay: .10s;
        }

        .product-form-field:nth-child(3) {
            animation-delay: .15s;
        }

        .product-form-field:nth-child(4) {
            animation-delay: .20s;
        }

        .product-form-field:nth-child(5) {
            animation-delay: .25s;
        }

        .product-form-field:nth-child(6) {
            animation-delay: .30s;
        }

        .product-form-field:nth-child(7) {
            animation-delay: .35s;
        }

    .product-form-label {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 9px;
        color: #314a48;
        font-size: 13px;
        font-weight: 750;
    }

        .product-form-label svg {
            width: 16px;
            height: 16px;
            color: #0f9d8a;
            flex-shrink: 0;
        }

    .product-form-control,
    .product-form-select {
        width: 100%;
        min-height: 46px;
        padding: 11px 14px;
        border: 1px solid #dfe7e6;
        border-radius: 12px;
        background: #fff;
        color: #243b39;
        font-size: 14px;
        outline: none;
        transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
    }

        .product-form-control::placeholder {
            color: #a9b5b4;
        }

        .product-form-control:hover,
        .product-form-select:hover {
            border-color: #c5d4d2;
        }

        .product-form-control:focus,
        .product-form-select:focus {
            border-color: #0f9d8a;
            box-shadow: 0 0 0 4px rgba(15, 157, 138, .10);
            background: #fff;
        }

    textarea.product-form-control {
        min-height: 145px;
        resize: vertical;
        line-height: 1.8;
    }

    .product-form-select {
        cursor: pointer;
        appearance: auto;
    }

    /* =========================
           Field Hint
        ========================= */

    .field-hint {
        display: flex;
        align-items: center;
        gap: 5px;
        margin-top: 7px;
        color: #91a09f;
        font-size: 11px;
    }

        .field-hint svg {
            width: 13px;
            height: 13px;
            flex-shrink: 0;
        }

    /* =========================
           Image URL Hint
        ========================= */

    .image-url-box {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-top: 9px;
        padding: 11px 13px;
        border-radius: 10px;
        background: #f7fbfa;
        border: 1px solid #e6f0ef;
        color: #71817f;
        font-size: 11px;
        line-height: 1.7;
    }

        .image-url-box svg {
            width: 15px;
            height: 15px;
            color: #0f9d8a;
            flex-shrink: 0;
            margin-top: 1px;
        }

    /* =========================
           Actions
        ========================= */

    .edit-product-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-top: 7px;
        margin-top: 8px;
        border-top: 1px solid #edf1f1;
    }

    .update-product-submit,
    .cancel-product-btn {
        min-height: 45px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 11px;
        font-size: 13px;
        font-weight: 750;
        text-decoration: none;
        cursor: pointer;
        transition: all .25s ease;
    }

    .update-product-submit {
        border: 1px solid #0f9d8a;
        background: #0f9d8a;
        color: #fff;
        box-shadow: 0 7px 18px rgba(15, 157, 138, .18);
    }

        .update-product-submit:hover {
            background: #0b8979;
            border-color: #0b8979;
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 10px 22px rgba(15, 157, 138, .24);
        }

    .cancel-product-btn {
        border: 1px solid #e0e7e6;
        background: #fff;
        color: #60716f;
    }

        .cancel-product-btn:hover {
            color: #334846;
            background: #f7f9f9;
            border-color: #cfd9d8;
            transform: translateY(-2px);
        }

        .update-product-submit svg,
        .cancel-product-btn svg {
            width: 17px;
            height: 17px;
        }

    /* =========================
           Animations
        ========================= */

    @@keyframes pageFadeIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes cardSlideUp {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fieldFadeIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes shakeIn {
        0% {
            opacity: 0;
            transform: translateX(-6px);
        }

        50% {
            transform: translateX(4px);
        }

        100% {
            opacity: 1;
            transform: translateX(0);
        }
    }

    /* =========================
           Responsive
        ========================= */

    @@media (max-width: 768px) {

        .edit-product-page {
            padding: 22px 16px;
        }

        .edit-product-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .back-products-btn {
            width: 100%;
            justify-content: center;
        }

        .edit-product-heading h1 {
            font-size: 24px;
        }

        .edit-product-card {
            border-radius: 18px;
        }

        .edit-product-card-header {
            padding: 19px;
        }

        .edit-product-form {
            padding: 20px;
        }

        .edit-product-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .update-product-submit,
        .cancel-product-btn {
            width: 100%;
        }
    }

    @@media (max-width: 500px) {

        .edit-product-page {
            padding: 18px 12px;
        }

        .edit-product-heading {
            gap: 11px;
        }

        .edit-product-title-icon {
            width: 46px;
            height: 46px;
            border-radius: 13px;
        }

        .edit-product-heading h1 {
            font-size: 21px;
        }

        .edit-product-heading p {
            font-size: 12px;
        }

        .edit-product-card-header {
            align-items: flex-start;
        }

        .edit-product-form {
            padding: 17px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {

        .edit-product-page,
        .edit-product-card,
        .product-form-field,
        .validation-summary {
            animation: none;
        }

        .back-products-btn,
        .update-product-submit,
        .cancel-product-btn,
        .product-form-control,
        .product-form-select {
            transition: none;
        }
    }
</style>


<div class="edit-product-page">

    <!-- Header -->
    <div class="edit-product-header">

        <div class="edit-product-heading">

            <div class="edit-product-title-icon">
                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <path d="M12 20h9"></path>

                    <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"></path>

                </svg>
            </div>

            <div>
                <h1>Update Product</h1>
                <p>Edit and update the information of this product.</p>
            </div>

        </div>


        <a asp-action="Index" class="back-products-btn">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <path d="M19 12H5"></path>
                <path d="M12 19l-7-7 7-7"></path>

            </svg>

            Back to Products

        </a>

    </div>


    <!-- Main Card -->
    <div class="edit-product-card">

        <div class="edit-product-card-header">

            <div class="form-header-icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <path d="M12 20h9"></path>

                    <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"></path>

                    <path d="M14.5 5.5l3 3"></path>

                </svg>

            </div>

            <div>
                <h2>Edit Product Information</h2>
                <p>Modify the product details and save your changes.</p>
            </div>

        </div>


        <form asp-action="Edit"
              method="post"
              class="edit-product-form">

            <input type="hidden" asp-for="Id" />


            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>


            <div class="row">

                <!-- Name -->
                <div class="col-md-6 product-form-field">

                    <label asp-for="Name"
                           class="product-form-label">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>

                            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>

                        </svg>

                        Product Name

                    </label>

                    <input asp-for="Name"
                           class="product-form-control"
                           placeholder="Enter product name" />

                    <span asp-validation-for="Name"
                          class="field-validation-error">
                    </span>

                </div>


                <!-- Author -->
                <div class="col-md-6 product-form-field">

                    <label asp-for="Author"
                           class="product-form-label">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M20 21a8 8 0 0 0-16 0"></path>

                            <circle cx="12"
                                    cy="7"
                                    r="4">
                            </circle>

                        </svg>

                        Author

                    </label>

                    <input asp-for="Author"
                           class="product-form-control"
                           placeholder="Enter author name" />

                    <span asp-validation-for="Author"
                          class="field-validation-error">
                    </span>

                </div>


                <!-- ISBN -->
                <div class="col-md-6 product-form-field">

                    <label asp-for="ISBN"
                           class="product-form-label">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M4 5v14"></path>
                            <path d="M8 5v14"></path>
                            <path d="M12 5v14"></path>
                            <path d="M16 5v14"></path>
                            <path d="M20 5v14"></path>

                        </svg>

                        ISBN

                    </label>

                    <input asp-for="ISBN"
                           class="product-form-control"
                           placeholder="Enter ISBN" />

                    <span asp-validation-for="ISBN"
                          class="field-validation-error">
                    </span>

                </div>


                <!-- Category -->
                <div class="col-md-6 product-form-field">

                    <label asp-for="CategoryId"
                           class="product-form-label">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M20 13.5V6a2 2 0 0 0-2-2h-7.5a2 2 0 0 0-1.4.6l-5.5 5.5a2 2 0 0 0 0 2.8l5.5 5.5a2 2 0 0 0 2.8 0l7.5-7.5A2 2 0 0 0 20 13.5z"></path>

                            <circle cx="14.5"
                                    cy="8.5"
                                    r="1">
                            </circle>

                        </svg>

                        Category

                    </label>

                    <select asp-for="CategoryId"
                            asp-items="ViewBag.Categories"
                            class="product-form-select">

                        <option value="">Select category</option>

                    </select>

                    <span asp-validation-for="CategoryId"
                          class="field-validation-error">
                    </span>

                </div>


                <!-- Price -->
                <div class="col-md-6 product-form-field">

                    <label asp-for="Price"
                           class="product-form-label">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <circle cx="12"
                                    cy="12"
                                    r="9">
                            </circle>

                            <path d="M14.5 8.5c-.5-.6-1.3-1-2.5-1-1.5 0-2.5.8-2.5 2s1 2 2.5 2 2.5.8 2.5 2-1 2-2.5 2c-1.2 0-2-.4-2.5-1"></path>

                            <path d="M12 5.5v13"></path>

                        </svg>

                        Price

                    </label>

                    <input asp-for="Price"
                           class="product-form-control"
                           type="number"
                           step="0.01"
                           min="0"
                           placeholder="0.00" />

                    <span asp-validation-for="Price"
                          class="field-validation-error">
                    </span>

                </div>


                <!-- Stock -->
                <div class="col-md-6 product-form-field">

                    <label asp-for="StockQuantity"
                           class="product-form-label">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M3 9l9-5 9 5"></path>
                            <path d="M4 9v10h16V9"></path>
                            <path d="M8 13h8"></path>
                            <path d="M8 16h5"></path>

                        </svg>

                        Stock Quantity

                    </label>

                    <input asp-for="StockQuantity"
                           class="product-form-control"
                           type="number"
                           min="0"
                           placeholder="0" />

                    <span asp-validation-for="StockQuantity"
                          class="field-validation-error">
                    </span>

                </div>


                <!-- Image URL -->
                <div class="col-12 product-form-field">

                    <label asp-for="ImageUrl"
                           class="product-form-label">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <rect x="3"
                                  y="3"
                                  width="18"
                                  height="18"
                                  rx="2">
                            </rect>

                            <circle cx="8.5"
                                    cy="8.5"
                                    r="1.5">
                            </circle>

                            <path d="M21 15l-5-5L5 21"></path>

                        </svg>

                        Image URL

                    </label>

                    <input asp-for="ImageUrl"
                           class="product-form-control"
                           placeholder="https://example.com/image.jpg" />

                    <span asp-validation-for="ImageUrl"
                          class="field-validation-error">
                    </span>

                    <div class="image-url-box">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <circle cx="12"
                                    cy="12"
                                    r="9">
                            </circle>

                            <path d="M12 11v5"></path>
                            <path d="M12 8h.01"></path>

                        </svg>

                        <span>
                            You can replace the current product image by entering a new image URL.
                        </span>

                    </div>

                </div>


                <!-- Description -->
                <div class="col-12 product-form-field">

                    <label asp-for="Description"
                           class="product-form-label">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M4 4h16v16H4z"></path>
                            <path d="M8 8h8"></path>
                            <path d="M8 12h8"></path>
                            <path d="M8 16h5"></path>

                        </svg>

                        Description

                    </label>

                    <textarea asp-for="Description"
                              class="product-form-control"
                              rows="5"
                              placeholder="Write a description for this product..."></textarea>

                    <span asp-validation-for="Description"
                          class="field-validation-error">
                    </span>

                </div>

            </div>


            <!-- Actions -->
            <div class="edit-product-actions">

                <button type="submit"
                        class="update-product-submit">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M20 6L9 17l-5-5"></path>

                    </svg>

                    Update Product

                </button>


                <a asp-action="Index"
                   class="cancel-product-btn">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M18 6L6 18"></path>
                        <path d="M6 6l12 12"></path>

                    </svg>

                    Cancel

                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}