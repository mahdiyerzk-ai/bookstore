@model IEnumerable<bookstore.Models.Product>
@{
    ViewData["Title"] = "Products";
    var search = ViewData["Search"] as string;
    var categoryId = ViewData["CategoryId"] as int?;
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h1>Products</h1><p class="text-muted mb-0">Manage bookstore products.</p></div>
        <a asp-action="Create" class="btn btn-primary">+ Add Product</a>
    </div>
    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    <form method="get" class="row g-2 mb-4">
        <div class="col-md-5"><input name="search" value="@search" class="form-control" placeholder="Search name, author or ISBN..." /></div>
        <div class="col-md-4">
            <select name="categoryId" asp-items="ViewBag.Categories" class="form-select">
                <option value="">All categories</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button class="btn btn-outline-primary" type="submit">Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </form>
    @if (!Model.Any())
    {
        <div class="alert alert-info">No products found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark"><tr><th>#</th><th>Product</th><th>Author</th><th>Category</th><th>ISBN</th><th>Price</th><th>Stock</th><th>Actions</th></tr></thead>
                <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>@product.Id</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl" alt="@product.Name" style="width:45px;height:55px;object-fit:cover;" class="rounded me-2" />
                            }
                            <strong>@product.Name</strong>
                        </td>
                        <td>@product.Author</td>
                        <td>@product.Category?.Name</td>
                        <td>@product.ISBN</td>
                        <td>@product.Price.ToString("N2")</td>
                        <td>@product.StockQuantity</td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">Details</a>
                                <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
