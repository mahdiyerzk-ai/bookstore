@model bookstore.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<style>
    .product-details-page {
        max-width: 1250px;
        margin: 0 auto;
        padding: 32px;
        animation: pageFadeIn .55s ease both;
    }

    /* =========================
           Header
        ========================= */

    .product-details-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }

    .product-details-heading {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .product-details-title-icon {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        background: rgba(15, 157, 138, .10);
        color: #0f9d8a;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .product-details-title-icon svg {
            width: 25px;
            height: 25px;
        }

    .product-details-heading h1 {
        margin: 0;
        color: #073b3a;
        font-size: 28px;
        font-weight: 800;
        letter-spacing: -.4px;
    }

    .product-details-heading p {
        margin: 5px 0 0;
        color: #7b8b8a;
        font-size: 14px;
    }

    .product-details-header-actions {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .details-edit-btn,
    .details-back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 43px;
        padding: 10px 16px;
        border-radius: 11px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 750;
        transition: all .25s ease;
    }

        .details-edit-btn svg,
        .details-back-btn svg {
            width: 17px;
            height: 17px;
        }

    .details-edit-btn {
        background: #0f9d8a;
        border: 1px solid #0f9d8a;
        color: #fff;
        box-shadow: 0 6px 16px rgba(15, 157, 138, .16);
    }

        .details-edit-btn:hover {
            background: #0b8979;
            border-color: #0b8979;
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 9px 20px rgba(15, 157, 138, .22);
        }

    .details-back-btn {
        background: #fff;
        border: 1px solid #e0e7e6;
        color: #60716f;
    }

        .details-back-btn:hover {
            background: #f7f9f9;
            border-color: #cfd9d8;
            color: #334846;
            transform: translateY(-2px);
        }

    /* =========================
           Main Card
        ========================= */

    .product-details-card {
        background: #fff;
        border: 1px solid #e8eeee;
        border-radius: 22px;
        box-shadow: 0 12px 35px rgba(7, 59, 58, .06);
        overflow: hidden;
        animation: cardSlideUp .65s ease both;
    }

    .product-details-card-top {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 21px 26px;
        border-bottom: 1px solid #edf1f1;
        background: linear-gradient( 180deg, #ffffff 0%, #fbfdfd 100% );
    }

    .card-top-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: rgba(15, 157, 138, .09);
        color: #0f9d8a;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .card-top-icon svg {
            width: 21px;
            height: 21px;
        }

    .product-details-card-top h2 {
        margin: 0;
        color: #073b3a;
        font-size: 17px;
        font-weight: 800;
    }

    .product-details-card-top p {
        margin: 3px 0 0;
        color: #8a9998;
        font-size: 12px;
    }

    .product-details-content {
        padding: 28px;
    }

    /* =========================
           Product Image
        ========================= */

    .product-image-section {
        height: 100%;
        min-height: 430px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 22px;
        border: 1px solid #e8eeee;
        border-radius: 18px;
        background: #f8faf9;
    }

    .product-image-wrapper {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .product-image {
        display: block;
        width: 100%;
        max-width: 270px;
        max-height: 390px;
        object-fit: contain;
        border-radius: 12px;
        box-shadow: 0 16px 35px rgba(7, 59, 58, .12);
        transition: transform .3s ease, box-shadow .3s ease;
    }

        .product-image:hover {
            transform: translateY(-4px) scale(1.01);
            box-shadow: 0 20px 42px rgba(7, 59, 58, .16);
        }

    .product-no-image {
        width: 100%;
        min-height: 350px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        border-radius: 15px;
        background: #f1f5f4;
        color: #94a3a1;
    }

        .product-no-image svg {
            width: 54px;
            height: 54px;
            color: #a8b7b5;
        }

        .product-no-image span {
            font-size: 13px;
            font-weight: 700;
        }

    /* =========================
           Product Information
        ========================= */

    .product-info-section {
        padding-left: 10px;
    }

    .product-main-info {
        padding-bottom: 21px;
        margin-bottom: 22px;
        border-bottom: 1px solid #edf1f1;
    }

        .product-main-info h2 {
            margin: 0;
            color: #073b3a;
            font-size: 26px;
            line-height: 1.4;
            font-weight: 800;
        }

    .product-author {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-top: 8px;
        color: #7b8b8a;
        font-size: 14px;
    }

        .product-author svg {
            width: 16px;
            height: 16px;
            color: #0f9d8a;
        }

    /* =========================
           Info Grid
        ========================= */

    .product-info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 13px;
    }

    .product-info-item {
        padding: 15px 16px;
        border: 1px solid #e8eeee;
        border-radius: 13px;
        background: #fbfcfc;
        transition: all .25s ease;
    }

        .product-info-item:hover {
            border-color: rgba(15, 157, 138, .25);
            background: #f8fcfb;
            transform: translateY(-2px);
        }

    .product-info-label {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 8px;
        color: #879593;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .3px;
    }

        .product-info-label svg {
            width: 15px;
            height: 15px;
            color: #0f9d8a;
        }

    .product-info-value {
        color: #263e3c;
        font-size: 14px;
        font-weight: 750;
        word-break: break-word;
    }

    .category-value {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 9px;
        border-radius: 7px;
        background: rgba(15, 157, 138, .09);
        color: #0f8173;
        font-size: 12px;
        font-weight: 750;
    }

    .isbn-value {
        font-family: monospace;
        letter-spacing: .4px;
    }

    .price-value {
        color: #0f9d8a;
        font-size: 16px;
        font-weight: 800;
    }

    /* =========================
           Stock Status
        ========================= */

    .stock-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 10px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 750;
    }

    .stock-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
    }

    .stock-available {
        background: #ecfdf3;
        color: #087443;
    }

        .stock-available .stock-dot {
            background: #12b76a;
        }

    .stock-low {
        background: #fffaeb;
        color: #a15c00;
    }

        .stock-low .stock-dot {
            background: #f79009;
        }

    .stock-out {
        background: #fff1f0;
        color: #b42318;
    }

        .stock-out .stock-dot {
            background: #f04438;
        }

    /* =========================
           Description
        ========================= */

    .product-description {
        margin-top: 22px;
        padding: 19px;
        border: 1px solid #e8eeee;
        border-radius: 15px;
        background: #fbfcfc;
    }

    .product-description-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 10px;
        color: #314a48;
        font-size: 13px;
        font-weight: 800;
    }

        .product-description-title svg {
            width: 17px;
            height: 17px;
            color: #0f9d8a;
        }

    .product-description-text {
        margin: 0;
        color: #687977;
        font-size: 13px;
        line-height: 2;
        white-space: pre-line;
    }

    .empty-description {
        color: #9aa7a5;
        font-style: italic;
    }

    /* =========================
           Bottom Actions
        ========================= */

    .product-details-footer {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 25px;
        padding-top: 22px;
        border-top: 1px solid #edf1f1;
    }

    .footer-edit-btn,
    .footer-back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 43px;
        padding: 10px 17px;
        border-radius: 11px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 750;
        transition: all .25s ease;
    }

        .footer-edit-btn svg,
        .footer-back-btn svg {
            width: 17px;
            height: 17px;
        }

    .footer-edit-btn {
        background: #0f9d8a;
        color: #fff;
        border: 1px solid #0f9d8a;
    }

        .footer-edit-btn:hover {
            background: #0b8979;
            border-color: #0b8979;
            color: #fff;
            transform: translateY(-2px);
        }

    .footer-back-btn {
        background: #fff;
        color: #60716f;
        border: 1px solid #e0e7e6;
    }

        .footer-back-btn:hover {
            background: #f7f9f9;
            color: #334846;
            border-color: #cfd9d8;
            transform: translateY(-2px);
        }

    /* =========================
           Animations
        ========================= */

    @@keyframes pageFadeIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes cardSlideUp {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* =========================
           Responsive
        ========================= */

    @@media (max-width: 992px) {

        .product-image-section {
            min-height: 380px;
        }

        .product-info-section {
            padding-left: 0;
            margin-top: 25px;
        }

        .product-image {
            max-height: 330px;
        }
    }

    @@media (max-width: 768px) {

        .product-details-page {
            padding: 22px 16px;
        }

        .product-details-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .product-details-header-actions {
            width: 100%;
        }

        .details-edit-btn,
        .details-back-btn {
            flex: 1;
        }

        .product-details-heading h1 {
            font-size: 24px;
        }

        .product-details-card {
            border-radius: 18px;
        }

        .product-details-card-top {
            padding: 19px;
        }

        .product-details-content {
            padding: 20px;
        }

        .product-image-section {
            min-height: 320px;
        }

        .product-info-grid {
            grid-template-columns: 1fr;
        }

        .product-main-info h2 {
            font-size: 23px;
        }

        .product-details-footer {
            flex-direction: column;
            align-items: stretch;
        }

        .footer-edit-btn,
        .footer-back-btn {
            width: 100%;
        }
    }

    @@media (max-width: 500px) {

        .product-details-page {
            padding: 18px 12px;
        }

        .product-details-heading {
            gap: 11px;
        }

        .product-details-title-icon {
            width: 46px;
            height: 46px;
            border-radius: 13px;
        }

        .product-details-heading h1 {
            font-size: 21px;
        }

        .product-details-heading p {
            font-size: 12px;
        }

        .product-details-header-actions {
            flex-direction: column;
        }

        .details-edit-btn,
        .details-back-btn {
            width: 100%;
            flex: none;
        }

        .product-details-content {
            padding: 16px;
        }

        .product-image-section {
            min-height: 280px;
            padding: 16px;
        }

        .product-image {
            max-height: 270px;
        }

        .product-no-image {
            min-height: 250px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {

        .product-details-page,
        .product-details-card {
            animation: none;
        }

        .details-edit-btn,
        .details-back-btn,
        .footer-edit-btn,
        .footer-back-btn,
        .product-image,
        .product-info-item {
            transition: none;
        }
    }
</style>


<div class="product-details-page">

    <!-- Header -->
    <div class="product-details-header">

        <div class="product-details-heading">

            <div class="product-details-title-icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>

                </svg>

            </div>

            <div>

                <h1>Product Details</h1>

                <p>
                    View complete information about this product.
                </p>

            </div>

        </div>


        <div class="product-details-header-actions">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="details-edit-btn">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <path d="M12 20h9"></path>
                    <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"></path>

                </svg>

                Edit Product

            </a>


            <a asp-action="Index"
               class="details-back-btn">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <path d="M19 12H5"></path>
                    <path d="M12 19l-7-7 7-7"></path>

                </svg>

                Back

            </a>

        </div>

    </div>


    <!-- Main Card -->
    <div class="product-details-card">

        <div class="product-details-card-top">

            <div class="card-top-icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                    <path d="M8 6h8"></path>
                    <path d="M8 10h8"></path>

                </svg>

            </div>

            <div>

                <h2>Product Information</h2>

                <p>
                    Detailed information and current inventory status.
                </p>

            </div>

        </div>


        <div class="product-details-content">

            <div class="row">

                <!-- Product Image -->
                <div class="col-lg-4">

                    <div class="product-image-section">

                        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                        {
                            <div class="product-image-wrapper">

                                <img src="@Model.ImageUrl"
                                     alt="@Model.Name"
                                     class="product-image" />

                            </div>
                        }
                        else
                        {
                            <div class="product-no-image">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.6"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <rect x="3"
                                          y="3"
                                          width="18"
                                          height="18"
                                          rx="2">
                                    </rect>

                                    <circle cx="8.5"
                                            cy="8.5"
                                            r="1.5">
                                    </circle>

                                    <path d="M21 15l-5-5L5 21"></path>

                                </svg>

                                <span>No image available</span>

                            </div>
                        }

                    </div>

                </div>


                <!-- Product Information -->
                <div class="col-lg-8">

                    <div class="product-info-section">

                        <!-- Main Info -->
                        <div class="product-main-info">

                            <h2>
                                @Model.Name
                            </h2>

                            @if (!string.IsNullOrWhiteSpace(Model.Author))
                            {
                                <div class="product-author">

                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">

                                        <path d="M20 21a8 8 0 0 0-16 0"></path>
                                        <circle cx="12"
                                                cy="7"
                                                r="4">
                                        </circle>

                                    </svg>

                                    <span>
                                        @Model.Author
                                    </span>

                                </div>
                            }

                        </div>


                        <!-- Info Grid -->
                        <div class="product-info-grid">

                            <!-- Category -->
                            <div class="product-info-item">

                                <div class="product-info-label">

                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">

                                        <path d="M20 13.5V6a2 2 0 0 0-2-2h-7.5a2 2 0 0 0-1.4.6l-5.5 5.5a2 2 0 0 0 0 2.8l5.5 5.5a2 2 0 0 0 2.8 0l7.5-7.5A2 2 0 0 0 20 13.5z"></path>

                                        <circle cx="14.5"
                                                cy="8.5"
                                                r="1">
                                        </circle>

                                    </svg>

                                    Category

                                </div>

                                <div class="product-info-value">

                                    @if (Model.Category != null)
                                    {
                                        <span class="category-value">
                                            @Model.Category.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }

                                </div>

                            </div>


                            <!-- ISBN -->
                            <div class="product-info-item">

                                <div class="product-info-label">

                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">

                                        <path d="M4 5v14"></path>
                                        <path d="M8 5v14"></path>
                                        <path d="M12 5v14"></path>
                                        <path d="M16 5v14"></path>
                                        <path d="M20 5v14"></path>

                                    </svg>

                                    ISBN

                                </div>

                                <div class="product-info-value isbn-value">

                                    @(string.IsNullOrWhiteSpace(Model.ISBN)
                                        ? "—"
                                        : Model.ISBN)

                                </div>

                            </div>


                            <!-- Price -->
                            <div class="product-info-item">

                                <div class="product-info-label">

                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">

                                        <circle cx="12"
                                                cy="12"
                                                r="9">
                                        </circle>

                                        <path d="M14.5 8.5c-.5-.6-1.3-1-2.5-1-1.5 0-2.5.8-2.5 2s1 2 2.5 2 2.5.8 2.5 2-1 2-2.5 2c-1.2 0-2-.4-2.5-1"></path>

                                        <path d="M12 5.5v13"></path>

                                    </svg>

                                    Price

                                </div>

                                <div class="product-info-value price-value">

                                    @Model.Price.ToString("N2")

                                </div>

                            </div>


                            <!-- Stock -->
                            <div class="product-info-item">

                                <div class="product-info-label">

                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">

                                        <path d="M3 9l9-5 9 5"></path>
                                        <path d="M4 9v10h16V9"></path>
                                        <path d="M8 13h8"></path>
                                        <path d="M8 16h5"></path>

                                    </svg>

                                    Stock

                                </div>

                                <div class="product-info-value">

                                    @if (Model.StockQuantity <= 0)
                                    {
                                        <span class="stock-badge stock-out">
                                            <span class="stock-dot"></span>
                                            Out of stock
                                        </span>
                                    }
                                    else if (Model.StockQuantity <= 5)
                                    {
                                        <span class="stock-badge stock-low">
                                            <span class="stock-dot"></span>
                                            @Model.StockQuantity left
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="stock-badge stock-available">
                                            <span class="stock-dot"></span>
                                            @Model.StockQuantity in stock
                                        </span>
                                    }

                                </div>

                            </div>

                        </div>


                        <!-- Description -->
                        <div class="product-description">

                            <div class="product-description-title">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <path d="M4 4h16v16H4z"></path>
                                    <path d="M8 8h8"></path>
                                    <path d="M8 12h8"></path>
                                    <path d="M8 16h5"></path>

                                </svg>

                                Description

                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.Description))
                            {
                                <p class="product-description-text">
                                    @Model.Description
                                </p>
                            }
                            else
                            {
                                <p class="product-description-text empty-description">
                                    No description has been added for this product.
                                </p>
                            }

                        </div>

                    </div>

                </div>

            </div>


            <!-- Footer Actions -->
            <div class="product-details-footer">

                <a asp-action="Edit"
