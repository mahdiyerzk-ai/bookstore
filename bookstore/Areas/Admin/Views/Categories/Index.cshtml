@model IEnumerable<bookstore.Models.Category>
@{
    ViewData["Title"] = "Categories";
}
@section Styles {
    
    <style>

        /* =========================================
               Categories Page
            ========================================= */

        .categories-page {
            width: 100%;
            max-width: 1450px;
            margin: 0 auto;
            padding: 32px;
            color: #172b2a;
        }


        /* =========================================
               Page Header
            ========================================= */

        .categories-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
            margin-bottom: 30px;
        }

        .categories-title {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .categories-title-icon {
            width: 54px;
            height: 54px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 15px;
            background: rgba(15, 157, 138, 0.1);
            color: #0f9d8a;
            flex-shrink: 0;
        }

            .categories-title-icon svg {
                width: 27px;
                height: 27px;
            }

        .categories-title h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 750;
            letter-spacing: -0.5px;
        }

        .categories-title p {
            margin: 5px 0 0;
            color: #7b8b8a;
            font-size: 14px;
        }


        /* =========================================
               Add Button
            ========================================= */

        .add-category-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            height: 46px;
            padding: 0 18px;
            border-radius: 12px;
            background: #0f9d8a;
            color: #fff;
            text-decoration: none;
            font-size: 14px;
            font-weight: 650;
            box-shadow: 0 8px 20px rgba(15, 157, 138, 0.18);
            transition: transform .25s ease, box-shadow .25s ease, background .25s ease;
        }

            .add-category-btn svg {
                width: 19px;
                height: 19px;
                transition: transform .25s ease;
            }

            .add-category-btn:hover {
                background: #0d8d7c;
                color: #fff;
                transform: translateY(-3px);
                box-shadow: 0 13px 25px rgba(15, 157, 138, 0.25);
            }

                .add-category-btn:hover svg {
                    transform: rotate(90deg);
                }


        /* =========================================
               Alerts
            ========================================= */

        .alerts-wrapper {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 24px;
        }

        .category-alert {
            display: flex;
            align-items: center;
            gap: 12px;
            min-height: 52px;
            padding: 10px 15px;
            border-radius: 13px;
            font-size: 14px;
            font-weight: 550;
            border: 1px solid transparent;
        }

        .alert-icon {
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 9px;
            flex-shrink: 0;
        }

            .alert-icon svg {
                width: 18px;
                height: 18px;
            }

        .success-alert {
            color: #08745f;
            background: #effbf7;
            border-color: #c8eee5;
        }

            .success-alert .alert-icon {
                background: #d8f5ed;
            }

        .error-alert {
            color: #b42318;
            background: #fff5f4;
            border-color: #ffd5d1;
        }

            .error-alert .alert-icon {
                background: #ffe1de;
            }


        /* =========================================
               Main Card
            ========================================= */

        .categories-card {
            background: #ffffff;
            border: 1px solid #e9eeee;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(21, 55, 51, 0.04), 0 1px 3px rgba(21, 55, 51, 0.03);
        }

        .table-top {
            min-height: 76px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 18px 22px;
            border-bottom: 1px solid #edf1f1;
        }

        .table-heading {
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .table-heading h2 {
                margin: 0;
                font-size: 17px;
                font-weight: 700;
            }

        .category-count {
            padding: 5px 10px;
            border-radius: 20px;
            background: #edf9f6;
            color: #0f9d8a;
            font-size: 12px;
            font-weight: 700;
        }


        /* =========================================
               Table
            ========================================= */

        .categories-table-wrapper {
            width: 100%;
            overflow-x: auto;
            scrollbar-width: thin;
            scrollbar-color: #cbd9d7 transparent;
        }

            .categories-table-wrapper::-webkit-scrollbar {
                height: 7px;
            }

            .categories-table-wrapper::-webkit-scrollbar-track {
                background: transparent;
            }

            .categories-table-wrapper::-webkit-scrollbar-thumb {
                background: #cbd9d7;
                border-radius: 20px;
            }

        .categories-table {
            width: 100%;
            min-width: 850px;
            border-collapse: collapse;
        }

            .categories-table thead {
                background: #f8faf9;
            }

            .categories-table th {
                height: 52px;
                padding: 0 22px;
                color: #788887;
                font-size: 12px;
                font-weight: 700;
                text-align: left;
                white-space: nowrap;
                border-bottom: 1px solid #edf1f1;
            }

            .categories-table td {
                padding: 17px 22px;
                border-bottom: 1px solid #f0f3f3;
                font-size: 13px;
                color: #4e6260;
                vertical-align: middle;
            }

            .categories-table tbody tr {
                transition: background .2s ease, transform .2s ease;
            }

                .categories-table tbody tr:hover {
                    background: #fbfdfc;
                }

                .categories-table tbody tr:last-child td {
                    border-bottom: none;
                }

        .id-column {
            width: 70px;
        }

        .actions-column {
            width: 270px;
        }


        /* =========================================
               Category ID
            ========================================= */

        .category-id {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 30px;
            height: 30px;
            padding: 0 8px;
            border-radius: 8px;
            background: #f2f6f5;
            color: #70817f;
            font-size: 12px;
            font-weight: 700;
        }


        /* =========================================
               Category Name
            ========================================= */

        .category-name {
            display: flex;
            align-items: center;
            gap: 11px;
            min-width: 170px;
        }

        .category-mini-icon {
            width: 35px;
            height: 35px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 9px;
            background: #eaf8f5;
            color: #0f9d8a;
            flex-shrink: 0;
            transition: transform .25s ease, background .25s ease;
        }

            .category-mini-icon svg {
                width: 18px;
                height: 18px;
            }

        .categories-table tbody tr:hover .category-mini-icon {
            transform: rotate(-5deg) scale(1.06);
            background: #dff4ef;
        }

        .category-name strong {
            color: #243b39;
            font-size: 14px;
            font-weight: 700;
        }


        /* =========================================
               Description
            ========================================= */

        .category-description {
            max-width: 400px;
            line-height: 1.7;
        }

        .no-description {
            color: #a0adac;
            font-style: italic;
            font-size: 12px;
        }


        /* =========================================
               Products Badge
            ========================================= */

        .products-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 38px;
            height: 29px;
            padding: 0 10px;
            border-radius: 8px;
            background: #f0f8f7;
            color: #0f8f7e;
            font-size: 12px;
            font-weight: 750;
        }


        /* =========================================
               Actions
            ========================================= */

        .category-actions {
            display: flex;
            align-items: center;
            gap: 7px;
            white-space: nowrap;
        }

        .action-btn {
            height: 34px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 0 10px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 11px;
            font-weight: 650;
            border: 1px solid;
            transition: color .2s ease, background .2s ease, border-color .2s ease, transform .2s ease;
        }

            .action-btn svg {
                width: 15px;
                height: 15px;
            }

            .action-btn:hover {
                transform: translateY(-2px);
            }

        .details-btn {
            color: #0f9d8a;
            background: #f3fbf9;
            border-color: #d4eee9;
        }

            .details-btn:hover {
                color: #fff;
                background: #0f9d8a;
                border-color: #0f9d8a;
            }

        .edit-btn {
            color: #566b69;
            background: #f7f9f9;
            border-color: #e1e7e6;
        }

            .edit-btn:hover {
                color: #344644;
                background: #edf1f0;
                border-color: #d4dcda;
            }

        .delete-btn {
            color: #c63f36;
            background: #fff7f6;
            border-color: #f4d9d6;
        }

            .delete-btn:hover {
                color: #fff;
                background: #d94b41;
                border-color: #d94b41;
            }


        /* =========================================
               Empty State
            ========================================= */

        .empty-category-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 390px;
            padding: 40px 25px;
            background: #fff;
            border: 1px solid #e9eeee;
            border-radius: 20px;
            text-align: center;
            box-shadow: 0 5px 20px rgba(21, 55, 51, 0.04);
        }

        .empty-icon {
            width: 76px;
            height: 76px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
            border-radius: 20px;
            background: #edf9f6;
            color: #0f9d8a;
        }

            .empty-icon svg {
                width: 37px;
                height: 37px;
            }

        .empty-category-card h3 {
            margin: 0 0 8px;
            color: #263c3a;
            font-size: 20px;
            font-weight: 750;
        }

        .empty-category-card p {
            max-width: 450px;
            margin: 0 0 22px;
            color: #82918f;
            font-size: 13px;
            line-height: 1.8;
        }

        .empty-add-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 43px;
            padding: 0 17px;
            border-radius: 10px;
            background: #0f9d8a;
            color: #fff;
            text-decoration: none;
            font-size: 13px;
            font-weight: 650;
            transition: transform .25s ease, box-shadow .25s ease;
        }

            .empty-add-btn:hover {
                color: #fff;
                transform: translateY(-3px);
                box-shadow: 0 10px 20px rgba(15, 157, 138, 0.2);
            }


        /* =========================================
               Entry Animations
            ========================================= */

        .page-enter {
            animation: pageEnter .55s cubic-bezier(.22, 1, .36, 1) both;
        }

        .page-enter-delay {
            animation: pageEnter .55s .08s cubic-bezier(.22, 1, .36, 1) both;
        }

        .page-enter-delay-2 {
            animation: pageEnter .6s .15s cubic-bezier(.22, 1, .36, 1) both;
        }

        @@keyframes pageEnter {

            from {
                opacity: 0;
                transform: translateY(18px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }


        /* =========================================
               Row Animation
            ========================================= */

        .categories-table tbody tr {
            animation: rowEnter .45s cubic-bezier(.22, 1, .36, 1) both;
        }

            .categories-table tbody tr:nth-child(1) {
                animation-delay: .20s;
            }

            .categories-table tbody tr:nth-child(2) {
                animation-delay: .25s;
            }

            .categories-table tbody tr:nth-child(3) {
                animation-delay: .30s;
            }

            .categories-table tbody tr:nth-child(4) {
                animation-delay: .35s;
            }

            .categories-table tbody tr:nth-child(5) {
                animation-delay: .40s;
            }

            .categories-table tbody tr:nth-child(6) {
                animation-delay: .45s;
            }

            .categories-table tbody tr:nth-child(7) {
                animation-delay: .50s;
            }

            .categories-table tbody tr:nth-child(8) {
                animation-delay: .55s;
            }

            .categories-table tbody tr:nth-child(9) {
                animation-delay: .60s;
            }

            .categories-table tbody tr:nth-child(10) {
                animation-delay: .65s;
            }

        @@keyframes rowEnter {

            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }


        /* =========================================
               Responsive
            ========================================= */

        @@media (max-width: 992px) {

            .categories-page {
                padding: 25px;
            }

            .categories-title h1 {
                font-size: 25px;
            }

            .category-description {
                max-width: 280px;
            }
        }


        @@media (max-width: 768px) {

            .categories-page {
                padding: 20px 16px;
            }

            .categories-header {
                align-items: flex-start;
                flex-direction: column;
                gap: 18px;
            }

            .categories-title {
                width: 100%;
            }

            .add-category-btn {
                width: 100%;
            }

            .categories-title h1 {
                font-size: 23px;
            }

            .categories-title-icon {
                width: 48px;
                height: 48px;
                border-radius: 13px;
            }

            .categories-card {
                border-radius: 16px;
            }

            .table-top {
                padding: 16px;
            }

            .category-actions {
                flex-wrap: nowrap;
            }
        }


        @@media (max-width: 500px) {

            .categories-page {
                padding: 16px 12px;
            }

            .categories-title {
                gap: 12px;
            }

            .categories-title-icon {
                width: 44px;
                height: 44px;
            }

                .categories-title-icon svg {
                    width: 23px;
                    height: 23px;
                }

            .categories-title h1 {
                font-size: 20px;
            }

            .categories-title p {
                font-size: 12px;
            }

            .add-category-btn {
                height: 44px;
                font-size: 13px;
            }

            .table-heading {
                justify-content: space-between;
                width: 100%;
            }

                .table-heading h2 {
                    font-size: 15px;
                }

            .category-count {
                font-size: 10px;
            }

            .empty-category-card {
                min-height: 340px;
                padding: 30px 18px;
            }

            .empty-icon {
                width: 65px;
                height: 65px;
                border-radius: 17px;
            }

                .empty-icon svg {
                    width: 31px;
                    height: 31px;
                }

            .empty-category-card h3 {
                font-size: 18px;
            }

            .empty-category-card p {
                font-size: 12px;
            }
        }


        /* =========================================
               Reduced Motion
            ========================================= */

        @@media (prefers-reduced-motion: reduce) {

            .page-enter,
            .page-enter-delay,
            .page-enter-delay-2,
            .categories-table tbody tr {
                animation: none;
            }

            .add-category-btn,
            .action-btn,
            .category-mini-icon,
            .empty-add-btn {
                transition: none;
            }
        }

    </style>
}

<div class="categories-page">

    <!-- Header -->
    <div class="categories-header page-enter">
        <div class="categories-title">
            <span class="categories-title-icon">
                <svg viewBox="0 0 24 24" fill="none">
                    <path d="M4 5.5C4 4.67 4.67 4 5.5 4H10V10H4V5.5Z"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linejoin="round"/>
                    <path d="M14 5.5C14 4.67 14.67 4 15.5 4H20V10H14V5.5Z"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linejoin="round"/>
                    <path d="M4 14H10V20H5.5C4.67 20 4 19.33 4 18.5V14Z"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linejoin="round"/>
                    <path d="M14 14H20V18.5C20 19.33 19.33 20 18.5 20H14V14Z"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linejoin="round"/>
                </svg>
            </span>

            <div>
                <h1>Categories</h1>
                <p>Manage bookstore categories.</p>
            </div>
        </div>

        <a asp-area="Admin"
           asp-controller="Categories"
           asp-action="Create"
           class="add-category-btn">

            <svg viewBox="0 0 24 24" fill="none">
                <path d="M12 5V19"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"/>
                <path d="M5 12H19"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"/>
            </svg>

            <span>Add Category</span>
        </a>
    </div>


    <!-- Alerts -->
    <div class="alerts-wrapper">

        @if (TempData["Success"] != null)
        {
            <div class="category-alert success-alert page-enter-delay">
                <div class="alert-icon">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M20 6L9 17L4 12"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"/>
                    </svg>
                </div>

                <span>@TempData["Success"]</span>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="category-alert error-alert page-enter-delay">
                <div class="alert-icon">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M12 8V12"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"/>
                        <path d="M12 16H12.01"
                              stroke="currentColor"
                              stroke-width="2.5"
                              stroke-linecap="round"/>
                        <circle cx="12"
                                cy="12"
                                r="9"
                                stroke="currentColor"
                                stroke-width="2"/>
                    </svg>
                </div>

                <span>@TempData["Error"]</span>
            </div>
        }

    </div>


    <!-- Empty State -->
    @if (!Model.Any())
    {
        <div class="empty-category-card page-enter-delay-2">

            <div class="empty-icon">
                <svg viewBox="0 0 24 24" fill="none">
                    <path d="M4 6.5C4 5.67 4.67 5 5.5 5H10V11H4V6.5Z"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linejoin="round"/>
                    <path d="M14 5H18.5C19.33 5 20 5.67 20 6.5V11H14V5Z"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linejoin="round"/>
                    <path d="M4 13H10V19H5.5C4.67 19 4 18.33 4 17.5V13Z"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linejoin="round"/>
                    <path d="M14 13H20V17.5C20 18.33 19.33 19 18.5 19H14V13Z"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linejoin="round"/>
                </svg>
            </div>

            <h3>No Categories Yet</h3>

            <p>
                No categories have been created yet.
                Start by creating your first bookstore category.
            </p>

            <a asp-area="Admin"
               asp-controller="Categories"
               asp-action="Create"
               class="empty-add-btn">
                Add Your First Category
            </a>

        </div>
    }
    else
    {
        <!-- Categories Table -->
        <div class="categories-card page-enter-delay-2">

            <div class="table-top">

                <div class="table-heading">
                    <h2>All Categories</h2>
                    <span class="category-count">
                        @Model.Count() categories
                    </span>
                </div>

            </div>

            <div class="categories-table-wrapper">

                <table class="categories-table">

                    <thead>
                        <tr>
                            <th class="id-column">#</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Products</th>
                            <th class="actions-column">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                    @foreach (var category in Model)
                    {
                        <tr>

                            <td>
                                <span class="category-id">
                                    @category.Id
                                </span>
                            </td>

                            <td>
                                <div class="category-name">
                                    <div class="category-mini-icon">
                                        <svg viewBox="0 0 24 24" fill="none">
                                            <path d="M4 6.5C4 5.67 4.67 5 5.5 5H10V11H4V6.5Z"
                                                  stroke="currentColor"
                                                  stroke-width="1.7"
                                                  stroke-linejoin="round"/>
                                            <path d="M14 5H18.5C19.33 5 20 5.67 20 6.5V11H14V5Z"
                                                  stroke="currentColor"
                                                  stroke-width="1.7"
                                                  stroke-linejoin="round"/>
                                            <path d="M4 13H10V19H5.5C4.67 19 4 18.33 4 17.5V13Z"
                                                  stroke="currentColor"
                                                  stroke-width="1.7"
                                                  stroke-linejoin="round"/>
                                            <path d="M14 13H20V17.5C20 18.33 19.33 19 18.5 19H14V13Z"
                                                  stroke="currentColor"
                                                  stroke-width="1.7"
                                                  stroke-linejoin="round"/>
                                        </svg>
                                    </div>

                                    <strong>@category.Name</strong>
                                </div>
                            </td>

                            <td>
                                <div class="category-description">
                                    @if (string.IsNullOrWhiteSpace(category.Description))
                                    {
                                        <span class="no-description">
                                            No description
                                        </span>
                                    }
                                    else
                                    {
                                        @category.Description
                                    }
                                </div>
                            </td>

                            <td>
                                <span class="products-badge">
                                    @category.Products.Count
                                </span>
                            </td>

                            <td>
                                <div class="category-actions">

                                    <a asp-action="Details"
                                       asp-route-id="@category.Id"
                                       class="action-btn details-btn"
                                       title="View Details">

                                        <svg viewBox="0 0 24 24" fill="none">
                                            <path d="M2.5 12C2.5 12 6 5.5 12 5.5C18 5.5 21.5 12 21.5 12C21.5 12 18 18.5 12 18.5C6 18.5 2.5 12 2.5 12Z"
                                                  stroke="currentColor"
                                                  stroke-width="1.8"
                                                  stroke-linejoin="round"/>
                                            <circle cx="12"
                                                    cy="12"
                                                    r="2.8"
                                                    stroke="currentColor"
                                                    stroke-width="1.8"/>
                                        </svg>

                                        <span>Details</span>
                                    </a>


                                    <a asp-action="Edit"
                                       asp-route-id="@category.Id"
                                       class="action-btn edit-btn"
                                       title="Edit Category">

                                        <svg viewBox="0 0 24 24" fill="none">
                                            <path d="M4 20H8L19 9C20.1 7.9 20.1 6.1 19 5C17.9 3.9 16.1 3.9 15 5L4 16V20Z"
