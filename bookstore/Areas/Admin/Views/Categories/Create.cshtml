@model bookstore.Models.Category

@{
    ViewData["Title"] = "Create Category";
}

@section Styles{
    <link rel="stylesheet" href="~/admin/css/categories-create-page.css" />
}

<div class="create-category-page">

    <!-- Header -->
    <div class="create-category-header page-enter">

        <div class="create-category-title">

            <span class="create-title-icon">
                <svg viewBox="0 0 24 24" fill="none">
                    <path d="M12 5V19"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round" />
                    <path d="M5 12H19"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round" />
                </svg>
            </span>

            <div>
                <h1>Create Category</h1>
                <p>Add a new category to your bookstore.</p>
            </div>

        </div>

        <a asp-action="Index"
           class="back-category-btn">

            <svg viewBox="0 0 24 24" fill="none">
                <path d="M19 12H5"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round" />
                <path d="M12 19L5 12L12 5"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round" />
            </svg>

            <span>Back to Categories</span>

        </a>

    </div>


    <!-- Form Card -->
    <div class="create-category-card page-enter-delay">

        <div class="create-card-header">

            <div>
                <h2>Category Information</h2>
                <p>Enter the information for your new bookstore category.</p>
            </div>

            <div class="form-card-icon">
                <svg viewBox="0 0 24 24" fill="none">
                    <path d="M4 6.5C4 5.67 4.67 5 5.5 5H10V11H4V6.5Z"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linejoin="round" />
                    <path d="M14 5H18.5C19.33 5 20 5.67 20 6.5V11H14V5Z"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linejoin="round" />
                    <path d="M4 13H10V19H5.5C4.67 19 4 18.33 4 17.5V13Z"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linejoin="round" />
                    <path d="M14 13H20V17.5C20 18.33 19.33 19 18.5 19H14V13Z"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linejoin="round" />
                </svg>
            </div>

        </div>


        <form asp-action="Create"
              method="post"
              asp-area="Admin"
              class="category-form">

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary"></div>


            <!-- Category Name -->
            <div class="form-group page-enter-field">

                <label asp-for="Name">
                    Category Name
                    <span>*</span>
                </label>

                <div class="input-wrapper">

                    <span class="input-icon">
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M4 6.5C4 5.67 4.67 5 5.5 5H10V11H4V6.5Z"
                                  stroke="currentColor"
                                  stroke-width="1.7"
                                  stroke-linejoin="round" />
                            <path d="M14 5H18.5C19.33 5 20 5.67 20 6.5V11H14V5Z"
                                  stroke="currentColor"
                                  stroke-width="1.7"
                                  stroke-linejoin="round" />
                            <path d="M4 13H10V19H5.5C4.67 19 4 18.33 4 17.5V13Z"
                                  stroke="currentColor"
                                  stroke-width="1.7"
                                  stroke-linejoin="round" />
                            <path d="M14 13H20V17.5C20 18.33 19.33 19 18.5 19H14V13Z"
                                  stroke="currentColor"
                                  stroke-width="1.7"
                                  stroke-linejoin="round" />
                        </svg>
                    </span>

                    <input asp-for="Name"
                           class="category-input"
                           placeholder="Enter category name..."
                           autocomplete="off" />

                </div>

                <span asp-validation-for="Name"
                      class="field-error"></span>

                <small class="field-hint">
                    Choose a clear and recognizable name for your category.
                </small>

            </div>


            <!-- Description -->
            <div class="form-group page-enter-field">

                <label asp-for="Description">
                    Description
                </label>

                <div class="textarea-wrapper">

                    <span class="textarea-icon">
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M6 4H18"
                                  stroke="currentColor"
                                  stroke-width="1.7"
                                  stroke-linecap="round" />
                            <path d="M6 8H18"
                                  stroke="currentColor"
                                  stroke-width="1.7"
                                  stroke-linecap="round" />
                            <path d="M6 12H14"
                                  stroke="currentColor"
                                  stroke-width="1.7"
                                  stroke-linecap="round" />
                            <path d="M6 16H12"
                                  stroke="currentColor"
                                  stroke-width="1.7"
                                  stroke-linecap="round" />
                        </svg>
                    </span>

                    <textarea asp-for="Description"
                              class="category-textarea"
                              rows="5"
                              placeholder="Write a short description for this category..."></textarea>

                </div>

                <span asp-validation-for="Description"
                      class="field-error"></span>

                <small class="field-hint">
                    A short description helps explain what products belong to this category.
                </small>

            </div>


            <!-- Form Actions -->
            <div class="form-actions page-enter-field">

                <button type="submit"
                        class="create-submit-btn">

                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M12 5V19"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round" />
                        <path d="M5 12H19"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round" />
                    </svg>

                    <span>Create Category</span>

                </button>


                <a asp-action="Index"
                   class="cancel-category-btn">

                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M6 6L18 18"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linecap="round" />
                        <path d="M18 6L6 18"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linecap="round" />
                    </svg>

                    <span>Cancel</span>

                </a>

            </div>

        </form>

    </div>

</div>





@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

