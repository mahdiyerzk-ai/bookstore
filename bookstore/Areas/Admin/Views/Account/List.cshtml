@{
    ViewData["Title"] = "کاربران";
    var users = ViewData["Users"] as List<User>;
}

<ul>
    <div class="users-table-wrapper">

        <div class="users-table-header">
            <div>
                <h2>لیست کاربران</h2>
                <p>مدیریت و مشاهده اطلاعات کاربران</p>
            </div>

            <span class="users-count">
                @users?.Count کاربر
            </span>
        </div>

        <div class="table-scroll">

            <table class="users-table">

                <thead>
                    <tr>
                        <th>#</th>
                        <th>نام و نام خانوادگی</th>
                        <th>ایمیل</th>
                        <th>شماره تماس</th>
                        <th>وضعیت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>

                <tbody>

                    @if (users != null && users.Any())
                    {
                        int counter = 1;

                        foreach (var user in users)
                        {
                            <tr>

                                <td>
                                    <span class="row-number">
                                        @counter
                                    </span>
                                </td>

                                <td>
                                    <div class="user-info">

                                        <div class="user-avatar">
                                            @user.FirstName?.Substring(0, 1)
                                        </div>

                                        <div>
                                            <strong>
                                                @user.FirstName @user.LastName
                                            </strong>

                                            <small>
                                                شناسه کاربر: @user.Id
                                            </small>
                                        </div>

                                    </div>
                                </td>

                                <td>
                                    <span class="email-text">
                                        @user.Email
                                    </span>
                                </td>

                                <td>
                                    <span class="phone-text">
                                        @user.PhoneNumber
                                    </span>
                                </td>

                                <td>
                                    <span class="status active">
                                        فعال
                                    </span>
                                </td>

                                <td>

                                    <div class="table-actions">

                                        <a href="/Admin/Account/Delete/@user.Id" class="action-btn view-btn" title="مشاهده">

                                            <svg width="18" height="18"
                                                 viewBox="0 0 24 24"
                                                 fill="none">

                                                <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"
                                                      stroke="currentColor"
                                                      stroke-width="1.7" />

                                                <circle cx="12"
                                                        cy="12"
                                                        r="2.5"
                                                        stroke="currentColor"
                                                        stroke-width="1.7" />

                                            </svg>

                                        </a>


                                        <a href="#" class="action-btn edit-btn" title="ویرایش">

                                            <svg width="18" height="18"
                                                 viewBox="0 0 24 24"
                                                 fill="none">

                                                <path d="M4 20h4l10.5-10.5a2.12 2.12 0 0 0-3-3L5 17v3Z"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linejoin="round" />

                                                <path d="m14.5 7.5 2 2"
                                                      stroke="currentColor"
                                                      stroke-width="1.7" />

                                            </svg>

                                        </a>


                                        <a href="#" class="action-btn delete-btn" title="حذف">

                                            <svg width="18" height="18"
                                                 viewBox="0 0 24 24"
                                                 fill="none">

                                                <path d="M4 7h16"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linecap="round" />

                                                <path d="M10 11v6M14 11v6"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linecap="round" />

                                                <path d="M6 7l1 13h10l1-13"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linejoin="round" />

                                                <path d="M9 7V4h6v3"
                                                      stroke="currentColor"
                                                      stroke-width="1.7"
                                                      stroke-linejoin="round" />

                                            </svg>

                                        </a>

                                    </div>

                                </td>

                            </tr>

                            counter++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">

                                <div class="empty-table">
                                    <div class="empty-icon">

                                        <svg width="32" height="32"
                                             viewBox="0 0 24 24"
                                             fill="none">

                                            <circle cx="12"
                                                    cy="8"
                                                    r="3"
                                                    stroke="currentColor"
                                                    stroke-width="1.7" />

                                            <path d="M5 20c.7-3.5 3.2-5 7-5s6.3 1.5 7 5"
                                                  stroke="currentColor"
                                                  stroke-width="1.7"
                                                  stroke-linecap="round" />

                                        </svg>

                                    </div>

                                    <strong>کاربری پیدا نشد</strong>
                                    <span>در حال حاضر هیچ کاربری در سیستم وجود ندارد.</span>
                                </div>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</ul>